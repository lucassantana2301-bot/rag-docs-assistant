# Copie para .env. Nunca versione o .env.

# Chave das rotas de escrita (upload e remoção). Gere com: openssl rand -hex 32
RAG_API_KEY=

# Embeddings: hashing (local, sem custo) | openai | ollama
RAG_EMBEDDING_PROVIDER=hashing
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_DIM=1536

# Respostas: extractive (sem LLM) | openai | anthropic | ollama
RAG_LLM_PROVIDER=extractive
# RAG_LLM_MODEL=

RAG_OPENAI_API_KEY=
RAG_ANTHROPIC_API_KEY=
RAG_OLLAMA_BASE_URL=http://localhost:11434

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
